# autoreel — env template (safe to commit). Copy to .env and fill.

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_API_BASE_URL=http://localhost:8081

# INSTAGRAM (Instagram API with Instagram Login — host is graph.instagram.com)
# The token is a 60-day long-lived token. Generate it in the Meta App Dashboard
# (Instagram > API setup with Instagram login > Generate token) with ALL FOUR scopes:
#   instagram_business_basic, instagram_business_content_publish,
#   instagram_business_manage_comments, instagram_business_manage_messages
# The last two are what the comment->DM autoresponder needs. `npm run refresh-ig-token`
# renews it; once it has EXPIRED it can't be refreshed, only regenerated.
IG_GRAPH_BASE_URL=https://graph.instagram.com
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_APP_ID=
IG_APP_SECRET=

# SUPABASE (storage bucket for the mp4s + the reel_posts table the site reads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=reels

# THE SITE (web/). Localhost until it's on Cloudflare. Once public, DM links go through the
# site's /go/<slug> redirect so clicks get counted.
SITE_URL=http://localhost:4321

# COMMENT -> DM AUTORESPONDER (bot/src/jobs/dm.ts). Needs the two manage_* scopes above.
# DM_FOLLOW_GATE: strict = link only to followers | soft = ask once, then send anyway | off = link in the first DM
DM_AUTORESPONDER=off
DM_FOLLOW_GATE=strict
DM_KEYWORD=TOOL
DM_POLL_MINUTES=2

# ANTHROPIC (optional — usually runs via Claude Code subscription)
# ANTHROPIC_API_KEY=
