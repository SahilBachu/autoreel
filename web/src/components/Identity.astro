---
import { site, instagramUrl } from "../config";
---

<header class="id">
  <a class="avatar" href={instagramUrl} aria-label={`@${site.handle} on Instagram`}>
    <img src={site.avatar} alt="" width="64" height="64" />
  </a>
  <div class="who">
    <a class="handle" href={instagramUrl}>@{site.handle}</a>
    {site.name && <div class="name">{site.name}</div>}
    {site.tagline && <p class="tag">{site.tagline}</p>}
  </div>
</header>

<style>
  .id {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 6px 0 26px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 22px;
  }
  .avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    padding: 2px;
    background: var(--bg2);
    box-shadow:
      0 0 0 1px var(--border-bright),
      0 0 44px -10px var(--accent-glow);
  }
  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg2);
  }
  .who {
    min-width: 0;
  }
  .handle {
    display: block;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .name {
    font-size: 13px;
    color: var(--dim);
    margin-top: 2px;
  }
  .tag {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--faint);
  }
</style>
