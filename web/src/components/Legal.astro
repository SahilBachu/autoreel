---
import Base from "../layouts/Base.astro";
import { site } from "../config";

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<Base title={title} article>
  <nav class="top">
    <a href="/" class="back">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10 3.5L5.5 8 10 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>@{site.handle}</span>
    </a>
  </nav>
  <article>
    <div class="kicker">Updated {updated}</div>
    <h1>{title}</h1>
    <div class="body"><slot /></div>
  </article>
</Base>

<style>
  .top { margin-bottom: 40px; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; color: var(--dim); }
  .back:hover { color: var(--text); }
  h1 { margin: 14px 0 0; font-size: clamp(27px, 7.2vw, 34px); font-weight: 600; letter-spacing: -0.032em; line-height: 1.12; }
  .body { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); font-size: 16px; line-height: 1.7; color: rgba(250, 250, 250, 0.86); }
  .body :global(p), .body :global(ul) { margin: 0 0 1.2em; }
  .body :global(ul) { padding-left: 1.2em; }
  .body :global(li) { margin-bottom: 0.4em; }
  .body :global(h2) { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; margin: 1.8em 0 0.5em; color: var(--text); }
  .body :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent-dim); text-underline-offset: 3px; }
</style>
