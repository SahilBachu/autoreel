---
import type { Post } from "../lib/db";
import { hostOf, shortDate, readMinutes } from "../lib/db";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const isTool = post.type === "tool";
const href = isTool ? `/go/${post.slug}` : `/p/${post.slug}`;
const kicker = isTool ? hostOf(post.tool_url) : `Read · ${readMinutes(post.article)} min`;
---

<a class:list={["block", post.type]} href={href} rel={isTool ? "noopener" : undefined}>
  <div class="meta">
    <span class:list={["kicker", "lead", { accent: isTool }]}>{kicker}</span>
    <time class="kicker date" datetime={post.published_at}>{shortDate(post.published_at)}</time>
  </div>
  <div class="row">
    <div class="text">
      <h2>{post.title}</h2>
      {post.blurb && <p>{post.blurb}</p>}
    </div>
    <span class="arrow" aria-hidden="true">
      {isTool ? (
        <svg viewBox="0 0 16 16" width="16" height="16"><path d="M4.5 11.5l7-7M6 4.5h5.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      ) : (
        <svg viewBox="0 0 16 16" width="16" height="16"><path d="M6 3.5L10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      )}
    </span>
  </div>
</a>

<style>
  .block {
    display: block;
    position: relative;
    padding: 16px 18px 17px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .block:hover {
    border-color: var(--border-bright);
    background: var(--surface2);
  }
  .block:active {
    transform: scale(0.992);
  }
  /* tool posts get the single accent touch: a faint glow on hover, nothing at rest */
  .block.tool:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 60px -24px var(--accent-glow);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 9px;
  }
  .meta .lead {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta .date {
    flex: none;
    white-space: nowrap;
  }
  .meta .accent {
    color: var(--accent-dim);
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .text {
    flex: 1;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.28;
    text-wrap: balance;
  }
  p {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--dim);
    text-wrap: pretty;
  }
  .arrow {
    flex: none;
    margin-top: 2px;
    color: var(--faint);
    transition: color 160ms ease, transform 160ms ease;
  }
  .block:hover .arrow {
    color: var(--text);
  }
  .block.tool:hover .arrow {
    transform: translate(1px, -1px);
  }
  .block.news:hover .arrow {
    transform: translateX(2px);
  }
</style>
